# ══════════════════════════════════════════════════════
# FERIA OS — Variables de entorno
# 1. Copia este archivo y renómbralo a: .env
# 2. Rellena los valores con tus credenciales reales
# 3. Reinicia el servidor: npm start
# ══════════════════════════════════════════════════════

# ── SUPABASE (Base de datos) ───────────────────────────
# Encuéntralas en: supabase.com → tu proyecto → Settings → API
REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── STRIPE (Cobros) — Fase siguiente ──────────────────
# Encuéntrala en: dashboard.stripe.com → Developers → API keys
# REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── WISE (Transferencias) — Fase siguiente ─────────────
# REACT_APP_WISE_API_KEY=...

# ── SUPABASE EDGE FUNCTIONS / SERVER SECRETS ─────────
# Configurar como secrets en Supabase, no en frontend público.
SUPABASE_SERVICE_ROLE_KEY=service_role_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://feria.design/pago-completado
PORTAL_LOGIN_URL=https://feria.design/login
RESEND_API_KEY=re_xxx
RESEND_FROM=Feria Design Studio <hola@feria.design>

# Feria OS v70 — portal access notifications
STUDIO_NAME=Feria Design Studio
STUDIO_WHATSAPP=+593990000000
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Demo accounts setup
# Use a private token to create/update demo users from the Login screen.
DEMO_SETUP_TOKEN=change-this-private-demo-token
# Alternative for closed/private staging only. Do NOT enable in public production.
DEMO_ACCOUNTS_PUBLIC_SETUP=false
